   <string notr="true">QDialog {
    background-color: #011C26;
}

QWidget {
	font: 13pt &quot;Helvetica&quot;;
    color: #F9F9F9;
}

QLabel[class=label] {
	font: 10pt;
    color: #F9F9F9;
}

QWidget[class=container] {
    background: #042F40;
	border-radius: 10px
}

QLabel[class=hint] {
	color: #799582;
}

QLabel[class=title] {
	font: 700 24pt;
}

QLineEdit{
	background-color: #011C26;
	border: none;
	border-radius: 6px;

}

/* --- Main Box --- */
QComboBox {
    background-color: #011C26;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
    color: #F9F9F9;
    /* This helps selection color in some styles */
    selection-background-color: #011C26;
}

/* --- The Dropdown Frame --- */
/* We target QListView specifically to override Mac defaults */
QComboBox QListView {
    background-color: #011C26;
    border: 1px solid #042F40; /* Your custom border */
    outline: 0px; /* Removes the dotted/blue focus line */
    padding: 0px;
}



/* --- The Arrow Button Area --- */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #042F40; /* Optional: adds a separator */
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    image: url(:/icons/icons/down.svg);
    width: 10px;
    height: 10px;
}

/* --- Main Spinbox Styling (Applies to both) --- */
QSpinBox, QDoubleSpinBox {
    background-color: #011C26;
    border: none;
    border-radius: 6px;
    color: #F9F9F9;
    padding: 5px 10px;
    padding-right: 15px;
}

/* --- The Button Container Areas --- */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 25px;

    border-left: 1px solid #042F40;
    border-top-right-radius: 6px;
    border-bottom: 1px solid #042F40;

    background-color: #011C26;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 25px;

    border-left: 1px solid #042F40;
    border-bottom-right-radius: 6px;

    background-color: #011C26;
}

/* --- Hover Effects --- */
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover, QComboBox::drop-down:hover {
    background-color: #042F40;
}

/* --- The Arrow Icons --- */
/* (Assuming you are using the CSS Arrow hack from before.
   If using images, replace these with your image: url(...) code) */

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/icons/up.svg); /* You need to create this file */
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/icons/down.svg); /* You need to create this file */
    width: 10px;
    height: 10px;
}

QToolButton {
    background-color: #032F40;
    border-radius: 16px;
    border: none;
    text-align: center;
}

QToolButton:hover {
    background-color: #314250;
}

QToolButton:pressed {
    background-color: #032F40;
}

QPushButton {
	color: #011C26;
	border-radius: 16px
}

QPushButton#b_save {
	background-color: #799582
}

QPushButton#b_delete {
	background-color: #D97855
}

/* 1. Base setup for the checkbox text and spacing */
QCheckBox {
    spacing: 12px;
    color: #ffffff; /* Text color */
}

/* 2. Define the size and shape of the box (The Indicator) */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 6px;  /* This creates the &quot;squircle&quot; roundness */
    border: 2px solid #9ab5a3; /* The Sage Green border */
}

/* 3. The Unchecked State (Empty with outline) */
QCheckBox::indicator:unchecked {
    background-color: transparent;
}

/* Optional: Slight hover effect for unchecked */
QCheckBox::indicator:unchecked:hover {
    background-color: rgba(154, 181, 163, 0.2);
}

/* 4. The Checked State (Filled Green) */
QCheckBox::indicator:checked {
    background-color: #9ab5a3;
    border: 2px solid #9ab5a3;

    /* CRITICAL: You must replace this path with your own icon!
       Since we painted over the native box, we have to put the checkmark back manually. */
    image: url(:/icons/icons/checkmark.svg);
}</string>
