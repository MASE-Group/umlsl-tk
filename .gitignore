# ---------------------------------------------------------------------------
# UMLSL Toolkit — repository-wide ignore rules
# Covers both sub-projects (UMLSL-Edit, UMLSL-Sim) and the top level.
# ---------------------------------------------------------------------------

# --- Python bytecode / caches ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / build artifacts --------------------------------------------
/build/
/dist/
UMLSL-Edit/build/
UMLSL-Edit/dist/
UMLSL-Sim/build/
UMLSL-Sim/dist/
*.egg-info/
*.egg
.eggs/
develop-eggs/
sdist/
wheels/
.installed.cfg
MANIFEST
pip-wheel-metadata/

# --- Virtual environments ----------------------------------------------------
# install.sh creates its venv at ./.env by default (see --venv).
.env/
.venv/
venv/
env/
ENV/
pyvenv.cfg

# Secret / dotenv files
.env.*
*.env

# --- Test & type-checker caches ---------------------------------------------
.pytest_cache/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.cache/

# --- Coverage ----------------------------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover

# --- Reinforcement-learning outputs ------------------------------------------
# rl_io.py writes rl_results/{models,hyperparameters} relative to the CWD,
# so this is intentionally unanchored.
rl_results/
*.optuna.db
optuna_study*.db
runs/
tensorboard/
*.pkl

# --- Qt / PySide -------------------------------------------------------------
# NOTE: the pyside6-uic output in view/widgets/compiled_widgets/ (ui_*.py,
# resources_rc.py) is imported at runtime and is NOT regenerated by install.sh,
# so it is deliberately tracked. Do not add ui_*.py / *_rc.py rules here.

# --- LaTeX auxiliary files (fig_architecture.tex and friends) ----------------
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
*.bbl
*.blg
*.lof
*.lot
*.latexmk

# --- Editors & IDEs -----------------------------------------------------------
.idea/
idea/
.vscode/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# --- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/

# --- OS cruft ------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs & temporary files -----------------------------------------------------
*.log
*.tmp
*.bak
